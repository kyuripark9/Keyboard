{
  "manifest_version": 3,
  "name": "clack",
  "version": "1.2.0",
  "description": "Something to press while claude.ai or ChatGPT answers: ten materials in your side panel that let go of you when it's done.",
  "homepage_url": "https://kyuripark9.github.io/Keyboard/",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Open clack",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "content_scripts": [
    { "matches": ["https://claude.ai/*", "https://chatgpt.com/*"], "js": ["watch.js"], "run_at": "document_idle" }
  ]
}
