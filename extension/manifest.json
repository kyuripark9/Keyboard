{
  "manifest_version": 3,
  "name": "clack",
  "version": "1.0.0",
  "description": "Something to press while your agent works: ten materials that click, pop and squish, in your browser's side panel.",
  "homepage_url": "https://kyuripark9.github.io/Keyboard/",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Open clack",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel"],
  "host_permissions": ["http://localhost:4545/*"]
}
